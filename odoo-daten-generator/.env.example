# Deployment configuration. Copy to .env next to docker-compose.yml.
#
# Two profiles, one image. `local` and `server` differ ONLY in bind address, TLS,
# access code and inbound reachability — guards, queue, workers and the pipeline
# itself are identical in both. Guard B (SSRF) in particular stays on locally: a
# security control that is switched on by configuration is a security control
# that eventually ships off.

# local | server
ODOO_GENERATOR_PROFILE=local

# Shared access code. There is no user identity: no emails are collected, so the
# GDPR surface is IPs only. Generate one, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(12))"
# Unset means every login is refused — the app never falls open.
ODOO_GENERATOR_ACCESS_CODE=

# Send the session cookie with the Secure flag. Defaults to true on the server
# profile, false on local (plain http on localhost drops a Secure cookie).
# ODOO_GENERATOR_COOKIE_SECURE=true

# Concurrency. Work is I/O-bound (HTTP to Odoo and to the LLM), so a Pi 5 copes
# with the ~5 concurrent runs expected. Request N+1 queues rather than spawning.
ODOO_GENERATOR_WORKERS=6
ODOO_GENERATOR_SESSION_RUN_LIMIT=2

# Writable paths. LEAVE THESE UNSET for a local run: the defaults sit next to the
# code (odoo-daten-generator/seeds/) and just work.
#
# Do NOT copy the container values here. docker-compose.yml sets /data/seeds/...
# itself, because that path only exists inside the container — on a laptop
# /data is not writable and the first cache write of every run fails with
# "[Errno 30] Read-only file system: '/data'".
# ODOO_GENERATOR_CACHE_DIR=
# ODOO_GENERATOR_RUNS_DIR=

# Bind address. 127.0.0.1 keeps a local instance off the network entirely.
ODOO_GENERATOR_BIND=127.0.0.1
ODOO_GENERATOR_PORT=8000

# Log retention in days. Run logs carry the demo hostname, which is
# prospect-identifying; retention is the control for that, not code.
ODOO_GENERATOR_LOG_RETENTION_DAYS=7

# BETA: fill blank connect fields from config.ini / the environment, so a tester
# can click Verbinden without pasting four values. The trade-off: the server then
# holds its own credentials, and the access code is the only thing in front of
# them. Guard A still applies, so the configured URL must itself be demo-*.odoo.com.
# Set to "off" when the beta ends.
ODOO_GENERATOR_CONFIG_DEFAULTS=on
